{
  "name": "dsh-asset-archiver",
  "version": "1.3.2",
  "private": true,
  "description": "Archive DSH workspaces, sessions and selected workspace files to Aliyun OSS and restore them on another device.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.5+": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/config.test.ts test/keys.test.ts test/files.test.ts test/file-tree.test.ts test/session.test.ts test/routes.test.ts test/index.test.ts test/client.test.tsx",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "ali-oss": "^6.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "license": "MIT"
}
